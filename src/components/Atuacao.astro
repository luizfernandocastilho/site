---
import { withBase } from '../lib/paths';
import { atuacaoAreaUrl } from '../lib/nav';
import { t, type Locale } from '../lib/i18n';
import AtuacaoIcon from './AtuacaoIcon.astro';
import type { AtuacaoIconName } from '../lib/atuacaoIcons';

interface AtuacaoItem {
  slug: string;
  title_pt: string;
  title_en: string;
  description_pt?: string;
  description_en?: string;
  url?: string;
  pdf?: string;
  cover?: string;
  coverHasTitle?: boolean;
  order?: number;
  icon?: AtuacaoIconName;
}

interface Props {
  id: string;
  locale: Locale;
  items: AtuacaoItem[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;
const base = import.meta.env.BASE_URL;
const label = t(strings, 'sectionAtuacao', fallback);
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{label}</h2>
    <ul class="atuacao-grid">
      {
        items.map((a) => {
          const title = locale === 'pt' ? a.title_pt : a.title_en;
          const description = locale === 'pt' ? a.description_pt : a.description_en;
          // Cada card leva à página da área (o deck fica acessível a partir dela).
          const href = atuacaoAreaUrl(locale, a.slug);
          const cover = a.cover
            ? a.cover.startsWith('http')
              ? a.cover
              : withBase(a.cover, base)
            : null;
          // Imagem que já traz o título embutido: oculta o título sobreposto do card.
          const coverHasTitle = Boolean(cover && a.coverHasTitle);
          return (
            <li class="atuacao-card">
              <a href={href}>
                <span class="atuacao-cover">
                  <span
                    class:list={[
                      'atuacao-slide',
                      cover && 'has-img',
                      coverHasTitle && 'title-in-img',
                    ]}
                  >
                    {cover && (
                      <img
                        class="atuacao-slide-img"
                        src={cover}
                        alt={coverHasTitle ? title : ''}
                        loading="lazy"
                        width="480"
                        height="270"
                      />
                    )}
                    {a.icon && (
                      <span class="atuacao-slide-icon">
                        <AtuacaoIcon name={a.icon} />
                      </span>
                    )}
                    {!coverHasTitle && <span class="atuacao-slide-title">{title}</span>}
                  </span>
                </span>
                <span class="atuacao-body">
                  {description && <span class="atuacao-desc">{description}</span>}
                  <span class="atuacao-action">{t(strings, 'atuacaoView', fallback)} →</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .atuacao-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .atuacao-card a,
  .atuacao-card div {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    height: 100%;
  }
  .atuacao-card a:hover {
    border-color: var(--color-accent);
  }
  .atuacao-cover {
    display: block;
    aspect-ratio: 16 / 9;
  }
  /* Capa (quando há imagem): fica ATRÁS do conteúdo do slide, sob um scrim. */
  .atuacao-slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Painel estilo slide: fundo verde + tipografia Oswald reversa; com capa, a imagem
     entra atrás e o ícone/título seguem visíveis sobre o scrim. */
  .atuacao-slide {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    /* Cor dos decks de Atuação (específica da seção; não usa o acento global). */
    background: #eee9df;
    color: var(--color-accent-contrast);
    /* Régua do topo de cada deck (específica da seção). */
    border-top: 3px solid #c9c1b1;
  }
  /* Scrim de legibilidade: reforça topo (ícone) e rodapé (título) sobre a imagem. */
  .atuacao-slide.has-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.1) 32%,
      rgba(0, 0, 0, 0.28) 62%,
      rgba(0, 0, 0, 0.72) 100%
    );
  }
  /* Imagem com título embutido: sem título sobreposto embaixo, então só um leve
     escurecimento no topo (para o ícone), sem o scrim pesado de rodapé. */
  .atuacao-slide.has-img.title-in-img::before {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.32) 0%,
      rgba(0, 0, 0, 0.05) 24%,
      rgba(0, 0, 0, 0) 55%
    );
  }
  /* Ícone no topo do slide (título fica no rodapé via justify-content: flex-end). */
  .atuacao-slide-icon {
    position: relative;
    z-index: 2;
    display: inline-flex;
    margin-bottom: auto;
    color: var(--color-accent-contrast);
  }
  .atuacao-slide-title {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.15;
  }
  .atuacao-slide.has-img .atuacao-slide-title {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
  }
  .atuacao-slide.has-img .atuacao-slide-icon {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5));
  }
  /* Sobre a foto o scrim é sempre escuro, então título/ícone vão em branco
     (independe do tema; o acento-contraste do painel verde seguiria escuro). */
  .atuacao-slide.has-img .atuacao-slide-title,
  .atuacao-slide.has-img .atuacao-slide-icon {
    color: #f3f4f6;
  }
  .atuacao-body {
    display: block;
    padding: 0.85rem 1rem 1rem;
  }
  .atuacao-desc {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .atuacao-action {
    display: block;
    margin-top: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
