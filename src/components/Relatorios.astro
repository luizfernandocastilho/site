---
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';
import DownloadGate from './DownloadGate.astro';

interface Relatorio {
  title: string;
  description_pt?: string;
  description_en?: string;
  pdf?: string;
  fileId?: string;
  cover?: string;
  date?: Date;
  order?: number;
}

interface Props {
  id: string;
  locale: Locale;
  items: Relatorio[];
  strings: Record<string, string>;
  fallback: Record<string, string>;
}

const { id, locale, items, strings, fallback } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{t(strings, 'navRecursoAnalises', fallback)}</h2>
    <ul class="relatorio-grid">
      {
        items.map((r) => {
          const description = locale === 'pt' ? r.description_pt : r.description_en;
          const cover = r.cover
            ? r.cover.startsWith('http')
              ? r.cover
              : withBase(r.cover, base)
            : null;
          const coverEl = (
            <span class="relatorio-cover">
              {cover ? (
                <img
                  class="relatorio-cover-img"
                  src={cover}
                  alt={r.title}
                  loading="lazy"
                  width="300"
                  height="450"
                />
              ) : (
                <span class="relatorio-slide">
                  <span class="relatorio-slide-title">{r.title}</span>
                </span>
              )}
            </span>
          );
          const bodyMeta = (
            <>
              <span class="relatorio-title">{r.title}</span>
              {description && <span class="relatorio-desc">{description}</span>}
            </>
          );

          // Gated (tem fileId): card não é link; o CTA abre um <details> com o formulário
          // de solicitação (nome/e-mail). Sem runtime JS (divulgação nativa).
          if (r.fileId) {
            return (
              <li class="relatorio-card">
                <div>
                  {coverEl}
                  <span class="relatorio-body">
                    {bodyMeta}
                    <details class="relatorio-gate">
                      <summary
                        class="relatorio-action"
                        data-umami-event="download-request"
                        data-umami-event-file={r.fileId}
                      >
                        {t(strings, 'articleDownload', fallback)} →
                      </summary>
                      <DownloadGate
                        id={`gate-${r.fileId}`}
                        fileId={r.fileId}
                        locale={locale}
                        strings={strings}
                        fallback={fallback}
                      />
                    </details>
                  </span>
                </div>
              </li>
            );
          }

          // Aberto (opt-out via pdf): download direto de PDF público.
          return (
            <li class="relatorio-card">
              <a
                href={withBase(r.pdf!, base)}
                download
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="download-pdf"
                data-umami-event-file={r.pdf}
              >
                {coverEl}
                <span class="relatorio-body">
                  {bodyMeta}
                  <span class="relatorio-action">{t(strings, 'articleDownload', fallback)} →</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .relatorio-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .relatorio-card a,
  .relatorio-card > div {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    height: 100%;
  }
  .relatorio-card a:hover {
    border-color: var(--color-accent);
  }
  .relatorio-cover {
    display: block;
    flex-shrink: 0;
    /* Item flex: zera o min-height automático para o aspect-ratio valer (não esticar
       até a altura intrínseca da imagem retrato). */
    min-height: 0;
    aspect-ratio: 3 / 4;
  }
  .relatorio-cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Painel estilo slide (sem capa): fundo verde, tipografia Oswald reversa. */
  .relatorio-slide {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-top: 3px solid var(--color-accent-vivid, #4fb055);
  }
  .relatorio-slide-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.15;
  }
  .relatorio-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 0.85rem 1rem 1rem;
  }
  .relatorio-title {
    display: block;
    font-weight: 600;
    line-height: 1.35;
  }
  .relatorio-desc {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .relatorio-action {
    display: block;
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  /* Card gated: empurra o bloco do CTA (<details>) para o rodapé, como nos demais. */
  .relatorio-gate {
    margin-top: auto;
  }
  /* Gate: CTA nativo (<summary>) que expande o formulário. */
  summary.relatorio-action {
    margin-top: 0;
    cursor: pointer;
    list-style: none;
  }
  summary.relatorio-action::-webkit-details-marker {
    display: none;
  }
  summary.relatorio-action:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
