---
import LanguageToggle from './LanguageToggle.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import { NAV_ITEMS, NAV_CHILDREN, navUrl, navChildUrl, atuacaoAreaUrl } from '../lib/nav';
import { getAtuacao } from '../lib/content';

interface Props {
  locale: Locale;
  strings: Record<string, string>;
  fallback: Record<string, string>;
  navKey: string;
  atuacaoSlug?: string;
  counterpartHref?: string;
}

const { locale, strings, fallback, navKey, atuacaoSlug, counterpartHref } = Astro.props;
const homeUrl = navUrl(NAV_ITEMS[0], locale);
const navLabel = locale === 'pt' ? 'Navegação principal' : 'Main navigation';
// Áreas de Atuação para o dropdown do menu.
const atuacaoAreas = await getAtuacao();
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeUrl} aria-label="Luiz Castilho">◆</a>
    <nav aria-label={navLabel} class="nav">
      {
        NAV_ITEMS.map((item) => {
          const isCurrent = item.key === navKey ? 'page' : undefined;
          const sectionUrl = navUrl(item, locale);
          const sectionLabel = t(strings, item.labelKey, fallback);

          // Sub-itens do dropdown: Atuação vem da collection; demais de NAV_CHILDREN.
          const subItems =
            item.key === 'atuacao'
              ? atuacaoAreas.map((a) => ({
                  href: atuacaoAreaUrl(locale, a.slug),
                  label: locale === 'pt' ? a.title_pt : a.title_en,
                }))
              : (NAV_CHILDREN[item.key] ?? []).map((c) => ({
                  href: navChildUrl(item, c, locale),
                  label: t(strings, c.labelKey, fallback),
                }));

          // Sem data-umami-event nos links de navegação: navegação na mesma aba não
          // pode depender do beacon do Umami (o tracker faz preventDefault +
          // location.href só após o POST /api/send resolver — se o analytics travar,
          // o link não navega). As seções seguem medidas por pageview. Ver #224.
          if (subItems.length === 0) {
            return (
              <a href={sectionUrl} aria-current={isCurrent}>
                {sectionLabel}
              </a>
            );
          }

          const toggleId = `navsub-${item.key}`;
          return (
            <div class="nav-item nav-has-dropdown">
              {/* Toggle só do mobile (checkbox-hack, sem JS); escondido no desktop. */}
              <input type="checkbox" id={toggleId} class="nav-subtoggle" />
              <span class="nav-item-head">
                {/* Sem data-umami-event: ver nota acima (#224). */}
                <a href={sectionUrl} aria-current={isCurrent}>
                  {sectionLabel}
                </a>
                <label
                  class="nav-subtoggle-btn"
                  for={toggleId}
                  aria-label={`${sectionLabel}: ${t(strings, 'navSubmenu', fallback)}`}
                >
                  <svg
                    class="nav-subtoggle-chevron"
                    width="14"
                    height="14"
                    viewBox="0 0 16 16"
                    aria-hidden="true"
                  >
                    <polyline points="4 6 8 10 12 6" />
                  </svg>
                </label>
              </span>
              <ul class="nav-dropdown">
                {subItems.map((s) => (
                  <li>
                    <a href={s.href}>{s.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </nav>
    <LanguageToggle
      locale={locale}
      strings={strings}
      fallback={fallback}
      navKey={navKey}
      atuacaoSlug={atuacaoSlug}
      counterpartHref={counterpartHref}
    />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.6rem;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-accent);
    font-size: 1.1rem;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-inline-start: auto;
  }
  .nav a {
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.95rem;
    padding-block: 0.15rem;
  }
  .nav a:hover {
    color: var(--color-text);
  }
  .nav a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  /* Item com dropdown (Atuação). Abre no hover e no foco por teclado (focus-within),
     sem runtime JS. */
  .nav-item {
    position: relative;
    display: inline-flex;
  }
  .nav-dropdown {
    position: absolute;
    top: 100%;
    inset-inline-start: 0;
    z-index: 60;
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
    min-width: 15rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 8%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  .nav-has-dropdown:hover .nav-dropdown,
  .nav-has-dropdown:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  /* O toggle (checkbox + chevron) é exclusivo do mobile; escondido no desktop. */
  .nav-subtoggle,
  .nav-subtoggle-btn {
    display: none;
  }
  .nav-dropdown li {
    margin: 0;
  }
  .nav-dropdown a {
    display: block;
    padding: 0.4rem 1rem;
    white-space: nowrap;
    color: var(--color-text);
  }
  .nav-dropdown a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown {
      transition: none;
    }
  }

  .lang-toggle,
  .site-header :global(.lang-toggle) {
    margin-inline-start: 0.5rem;
  }
  @media (max-width: 40rem) {
    .header-inner {
      flex-wrap: wrap;
    }
    .nav {
      order: 3;
      width: 100%;
      margin-inline-start: 0;
    }
    /* Em telas estreitas o dropdown é uma lista estática, COLAPSADA por padrão,
       que abre ao tocar no chevron (checkbox-hack, sem JS). */
    .nav-item {
      display: block;
      width: 100%;
    }
    .nav-item-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    /* Checkbox visualmente escondido, mas focável por teclado. */
    .nav-subtoggle {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .nav-subtoggle-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.35rem;
      color: var(--color-muted);
      cursor: pointer;
    }
    .nav-subtoggle-chevron {
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 0.2s ease;
    }
    .nav-subtoggle:checked ~ .nav-item-head .nav-subtoggle-chevron {
      transform: rotate(180deg);
    }
    .nav-subtoggle:focus-visible ~ .nav-item-head .nav-subtoggle-btn {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }
    .nav-dropdown {
      position: static;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      min-width: 0;
      padding: 0.15rem 0 0.35rem;
      border: 0;
      box-shadow: none;
      background: transparent;
    }
    .nav-subtoggle:checked ~ .nav-dropdown {
      display: block;
    }
    .nav-dropdown a {
      padding: 0.25rem 0 0.25rem 1rem;
      color: var(--color-muted);
    }
    @media (prefers-reduced-motion: reduce) {
      .nav-subtoggle-chevron {
        transition: none;
      }
    }
  }
</style>
