---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUi, getProfile } from '../lib/content';
import { navUrl } from '../lib/nav';
import { NAV_ITEMS } from '../lib/nav';
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';

interface Area {
  slug: string;
  title_pt: string;
  title_en: string;
  description_pt?: string;
  description_en?: string;
  body_pt?: string[];
  body_en?: string[];
  highlights_pt?: string[];
  highlights_en?: string[];
  url?: string;
  pdf?: string;
  pdf_pt?: string;
  pdf_en?: string;
  cover?: string;
  order?: number;
}

interface Props {
  locale: Locale;
  area: Area;
}

const { locale, area } = Astro.props;
const { strings, fallback } = await getUi(locale);
const profile = await getProfile();

const title = locale === 'pt' ? area.title_pt : area.title_en;
const description = locale === 'pt' ? area.description_pt : area.description_en;
const body = locale === 'pt' ? area.body_pt : area.body_en;
const highlights = locale === 'pt' ? area.highlights_pt : area.highlights_en;
const sectionLabel = t(strings, 'sectionAtuacao', fallback);
const pageTitle = `${title} · ${profile?.name ?? 'Site Pessoal'}`;

const base = import.meta.env.BASE_URL;
// Documento oficial por idioma (download aberto); cai em `pdf` se o locale não tiver.
const pdfFile = (locale === 'pt' ? area.pdf_pt : area.pdf_en) ?? area.pdf ?? null;
const pdfHref = pdfFile ? withBase(pdfFile, base) : null;
const externalHref = area.url ?? null;
const coverSrc = area.cover
  ? area.cover.startsWith('http')
    ? area.cover
    : withBase(area.cover, base)
  : null;
const gridUrl = navUrl(
  NAV_ITEMS.find((i) => i.key === 'atuacao')!,
  locale,
);
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={description ?? title}
  strings={strings}
  fallback={fallback}
  navKey="atuacao"
  atuacaoSlug={area.slug}
>
  <section class="section">
    <div class="container area">
      <p class="section-label">{sectionLabel}</p>
      <h1>{title}</h1>
      {description && <p class="area-lead">{description}</p>}

      {
        coverSrc && (
          <img
            class="area-cover"
            src={coverSrc}
            alt={locale === 'pt' ? `Ilustração — ${title}` : `Illustration — ${title}`}
            width="1408"
            height="768"
            loading="lazy"
          />
        )
      }

      {body?.map((paragraph) => <p class="area-body">{paragraph}</p>)}

      {
        highlights && highlights.length > 0 && (
          <div class="area-highlights">
            <p class="area-highlights-label">{t(strings, 'atuacaoHighlights', fallback)}</p>
            <ul>
              {highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        pdfHref ? (
          <a
            class="area-download"
            href={pdfHref}
            download
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="download-pdf"
            data-umami-event-file={pdfFile}
          >
            {t(strings, 'atuacaoDownload', fallback)}
            <span aria-hidden="true"> ↓</span>
          </a>
        ) : externalHref ? (
          <a class="area-deck" href={externalHref} target="_blank" rel="noopener noreferrer">
            {t(strings, 'atuacaoView', fallback)} →
          </a>
        ) : (
          <p class="area-soon">{t(strings, 'atuacaoDeckSoon', fallback)}</p>
        )
      }

      <p class="area-back">
        <a href={gridUrl}>← {t(strings, 'atuacaoBack', fallback)}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .area {
    max-width: 48rem;
  }
  .area-lead {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .area-cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1.5rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }
  .area-body {
    margin-top: 1rem;
    line-height: 1.65;
    color: var(--color-text);
  }
  .area-highlights {
    margin-top: 1.75rem;
  }
  .area-highlights-label {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .area-highlights ul {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.35rem;
  }
  .area-highlights li {
    line-height: 1.5;
  }
  .area-deck {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--color-accent);
    font-weight: 600;
  }
  /* Documento oficial — botão sólido destacado (CTA) para baixar e circular. */
  .area-download {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.75rem 1.4rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .area-download:hover {
    filter: brightness(1.08);
  }
  .area-soon {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }
  .area-back {
    margin-top: 2.5rem;
  }
  .area-back a {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 600;
  }
  .area-back a:hover {
    color: var(--color-text);
  }
</style>
