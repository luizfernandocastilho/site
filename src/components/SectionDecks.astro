---
import { NAV_ITEMS, NAV_CHILDREN, navChildUrl } from '../lib/nav';
import { withBase } from '../lib/paths';
import DeckIcon from './DeckIcon.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  id: string;
  locale: Locale;
  strings: Record<string, string>;
  fallback: Record<string, string>;
  /** Chave do item pai em NAV_ITEMS/NAV_CHILDREN (ex.: 'resources', 'publications'). */
  parentKey: string;
  /** Chave da string de título da seção (ex.: 'sectionResources'). */
  sectionLabelKey: string;
}

const { id, locale, strings, fallback, parentKey, sectionLabelKey } = Astro.props;
// Cada subitem (nav.ts) vira um deck que leva à sua página interna.
const parent = NAV_ITEMS.find((i) => i.key === parentKey)!;
const children = NAV_CHILDREN[parentKey] ?? [];
const label = t(strings, sectionLabelKey, fallback);
const base = import.meta.env.BASE_URL;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <h2 id={`${id}-title`}>{label}</h2>
    <ul class="deck-grid">
      {
        children.map((c) => {
          const title = t(strings, c.labelKey, fallback);
          const cover = c.cover
            ? c.cover.startsWith('http')
              ? c.cover
              : withBase(c.cover, base)
            : null;
          // Com `pdf`: o card vira um link de download; senão, abre a página interna.
          const download = c.pdf ? withBase(c.pdf, base) : null;
          const linkProps = download
            ? {
                href: download,
                download: true,
                target: '_blank',
                rel: 'noopener noreferrer',
                'data-umami-event': 'download-pdf',
                'data-umami-event-file': c.pdf,
              }
            : { href: navChildUrl(parent, c, locale) };
          const actionKey = download ? 'articleDownload' : 'resourceOpen';
          return (
            <li class="deck-card">
              <a {...linkProps}>
                <span class="deck-cover">
                  <span class={`deck-slide${cover ? ' has-cover' : ''}`}>
                    {cover && (
                      <img
                        class="deck-cover-img"
                        src={cover}
                        alt={title}
                        loading="lazy"
                        width="960"
                        height="524"
                      />
                    )}
                    {c.icon && (
                      <span class="deck-slide-icon">
                        <DeckIcon name={c.icon} />
                      </span>
                    )}
                    <span class="deck-slide-title">{title}</span>
                  </span>
                </span>
                <span class="deck-body">
                  <span class="deck-action">{t(strings, actionKey, fallback)} →</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .deck-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .deck-card a {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    height: 100%;
  }
  .deck-card a:hover {
    border-color: var(--color-accent);
  }
  .deck-cover {
    display: block;
    aspect-ratio: 16 / 9;
  }
  /* Painel estilo slide (sem capa): fundo verde, tipografia Oswald reversa. */
  .deck-slide {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-top: 3px solid var(--color-accent-vivid, #4fb055);
    overflow: hidden;
  }
  /* Com capa: a imagem vira o fundo; gradiente escurece o rodapé para o título ficar legível. */
  .deck-slide.has-cover {
    background: var(--color-text);
  }
  .deck-cover-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .deck-slide.has-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 82%) 0%, rgb(0 0 0 / 45%) 38%, transparent 72%);
  }
  /* Ícone no topo do slide (título fica no rodapé via justify-content: flex-end). */
  .deck-slide-icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    margin-bottom: auto;
    color: var(--color-accent-contrast);
  }
  .deck-slide-title {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.15;
  }
  /* Sobre a foto o scrim é sempre escuro: título/ícone em branco (independe do tema). */
  .deck-slide.has-cover .deck-slide-title,
  .deck-slide.has-cover .deck-slide-icon {
    color: #fff;
  }
  .deck-slide.has-cover .deck-slide-title {
    text-shadow: 0 1px 3px rgb(0 0 0 / 55%);
  }
  .deck-body {
    display: block;
    padding: 0.85rem 1rem 1rem;
  }
  .deck-action {
    display: block;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
