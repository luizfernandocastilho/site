---
import type { Locale } from '../lib/i18n';
import { otherLocale, t } from '../lib/i18n';
import { counterpartUrl, atuacaoAreaUrl } from '../lib/nav';

interface Props {
  locale: Locale;
  strings: Record<string, string>;
  fallback: Record<string, string>;
  navKey: string;
  atuacaoSlug?: string;
  counterpartHref?: string;
}

const { locale, strings, fallback, navKey, atuacaoSlug, counterpartHref } = Astro.props;
const target = otherLocale(locale);
// Link para a MESMA página no outro idioma (preserva a página). Sem JS.
// `counterpartHref` (páginas internas dedicadas) tem precedência; senão, área de
// Atuação pelo slug; senão, a seção do próprio item.
const href =
  counterpartHref ??
  (atuacaoSlug ? atuacaoAreaUrl(target, atuacaoSlug) : counterpartUrl(navKey, target));
---

{
  /* Sem data-umami-event: o toggle navega na mesma aba e não pode depender do beacon
    do Umami (preventDefault + location.href só após o POST /api/send resolver). A
    troca de idioma segue medida por pageview da página de destino. Ver #224. */
}
<a class="lang-toggle" href={href} hreflang={target}>
  <span class="visually-hidden">{t(strings, 'langToggleLabel', fallback)}: </span>{
    t(strings, 'langSwitchTo', fallback)
  }
</a>

<style>
  .lang-toggle {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--color-text);
    white-space: nowrap;
  }
  .lang-toggle:hover {
    background: var(--color-surface);
  }
</style>
