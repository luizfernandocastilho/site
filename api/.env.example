# Postgres (usados pelo docker-compose e pela DATABASE_URL)
POSTGRES_USER=site
POSTGRES_PASSWORD=changeme
POSTGRES_DB=site_downloads

# Conexão da API ao banco (em produção aponte para o Postgres do NAS)
DATABASE_URL=postgres://site:changeme@postgres:5432/site_downloads

# Segurança
APP_SECRET=troque-por-um-segredo-forte
ADMIN_TOKEN=troque-por-um-token-de-admin

# URLs públicas
PUBLIC_BASE_URL=http://localhost:3000
SITE_URL=https://www.luizcastilho.com

# Validade do link de download (horas)
TOKEN_TTL_HOURS=168

# SMTP (deixe SMTP_HOST vazio em dev → o link é apenas logado no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Luiz Castilho <no-reply@luizcastilho.com>

# Porta pública mapeada no host
API_PORT=3000

# Analytics Umami (opcional): dispara o evento server-side `download-complete` na
# conclusão do download. Vazio = desligado. Use o mesmo website id do site.
UMAMI_HOST=https://nas-castilho.tailb53d63.ts.net
UMAMI_WEBSITE_ID=ab3f97b2-5318-4ba9-9f56-c0e087045a06
